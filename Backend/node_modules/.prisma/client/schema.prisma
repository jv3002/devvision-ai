generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id   String @id @default(uuid())
  name String

  users User[]
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String

  role Role @default(MEMBER)
  plan Plan @default(FREE)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  repoUrl     String
  repoPath    String
  createdAt   DateTime @default(now())

  metrics      Metric[]
  analysisRuns AnalysisRun[]
  commits      Commit[]
  scoreHistory ProjectScoreHistory[]
}

model AnalysisRun {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())

  result Json?

  project Project  @relation(fields: [projectId], references: [id])
  metrics Metric[]
}

model Metric {
  id    String @id @default(uuid())
  name  String
  value Int

  projectId  String
  analysisId String

  project  Project     @relation(fields: [projectId], references: [id])
  analysis AnalysisRun @relation(fields: [analysisId], references: [id])
}

model Commit {
  id        String   @id @default(uuid())
  message   String
  author    String?
  date      DateTime
  score     Int
  projectId String

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectScoreHistory {
  id        String   @id @default(uuid())
  score     Float
  trend     String
  risk      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}
